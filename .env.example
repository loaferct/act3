# Model served on AMD GPUs (OpenAI-compatible). Option A: AMD Token Factory (hackathon API)
LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
LLM_API_KEY=<your team's rc-... key>
LLM_MODEL=DeepSeek-V4-Flash
LLM_REASONING_EFFORT=none
LLM_HARDWARE="AMD Instinct GPU · AMD Token Factory"

# Option B: your own vLLM on an AMD Instinct MI300X (AMD Developer Cloud), see deploy/AMD.md
# LLM_BASE_URL=http://<droplet-ip>:8000/v1
# LLM_API_KEY=<the --api-key you started vLLM with>
# LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# LLM_HARDWARE="AMD Instinct MI300X · ROCm · vLLM"

# Self-hosted vLLM only (leave LLM_REASONING_EFFORT empty there): turn off Qwen3 thinking via chat_template_kwargs
LLM_DISABLE_THINKING=1
